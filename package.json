{
	"name": "demo",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
		"build": "vite build",
		"build:single": "VITE_SINGLE_FILE=true vite build",
    "deploy": "npm run build && gh-pages -d dist",
    "deploy:single": "npm run build:single && gh-pages -d dist-single",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"typescript": "~6.0.2",
		"vite": "^8.2.0"
	},
	"dependencies": {
		"@edujed/jedsvelted-ui": "0.0.1-alpha.4",
		"gh-pages": "^6.3.0",
		"save-dev": "^0.0.1-security"
	}
}
